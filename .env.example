# Supabase project credentials
# Find them in: Supabase Dashboard → Project Settings → API
#
# The anon key is PUBLIC by design — it is safe to expose in the browser
# because data access is enforced by PostgreSQL Row Level Security (RLS).
# NEVER put the service_role key in this file or anywhere in the frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ------------------------------------------------------------
# AI provider (Phase 5) — SERVER-SIDE ONLY. These are Supabase
# EDGE FUNCTION secrets, NOT Vite variables: they must never be
# prefixed with VITE_ (that would ship the key in the browser
# bundle) and must never be committed. Set them with the
# Supabase CLI:
#
#   supabase secrets set AI_API_KEY=sk-your-key-here
#
# AI_MODEL and AI_API_BASE_URL are optional — the Edge Function
# ships with sensible OpenAI defaults (gpt-4o-mini, api.openai.com).
# Any OpenAI-compatible endpoint works via AI_API_BASE_URL.
# ------------------------------------------------------------
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini
# AI_API_BASE_URL=https://api.openai.com/v1
